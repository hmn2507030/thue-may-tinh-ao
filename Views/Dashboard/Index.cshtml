@model DashboardVm
@{ ViewData["Title"]="Máy ảo của tôi"; }
<div class="section-heading"><div><span class="eyebrow">YOUR WORKSPACE</span><h1>Máy ảo của tôi</h1><p class="muted">Chào bạn, quản lý tài nguyên và theo dõi yêu cầu thuê tại đây.</p></div><a class="btn btn-primary" asp-controller="Plans" asp-action="Index">+ Thuê máy mới</a></div>
<div class="stats-grid three"><div class="stat"><span>Tổng máy ảo</span><strong>@Model.Machines.Count</strong></div><div class="stat"><span>Đang hoạt động</span><strong>@Model.Machines.Count(x=>x.Status==VmStatus.Running)</strong></div><div class="stat"><span>Đã dừng</span><strong>@Model.Machines.Count(x=>x.Status==VmStatus.Stopped)</strong></div></div>
@if(Model.Machines.Count==0) { <div class="empty-state"><h3>Workspace đang chờ bạn</h3><p>Máy ảo sẽ xuất hiện khi quản trị viên duyệt đơn thuê.</p><a asp-controller="Plans" asp-action="Index" class="btn btn-primary">Chọn gói đầu tiên</a></div> }
<div class="machine-grid">@foreach(var vm in Model.Machines) { <article class="panel machine-card"><div class="card-top"><span class="eyebrow">@vm.Order.Type</span><span class="badge-state @vm.Status.ToString().ToLowerInvariant()">@Display.Status(vm.Status)</span></div><h3>@vm.VmName</h3><p class="muted">@vm.Order.PlanName</p><div class="config-row"><span>@vm.Order.CPU vCPU</span><span>@vm.Order.RAM GB</span><span>@vm.Order.Storage GB</span></div><dl class="key-values"><dt>IP mô phỏng</dt><dd><code>@vm.IpAddress</code></dd><dt>Hết hạn</dt><dd>@Display.Date(vm.ExpiresAt)</dd></dl><a class="btn btn-outline full" asp-action="Details" asp-route-id="@vm.Id">Chi tiết & điều khiển →</a></article> }</div>
<div class="section-heading"><h2>Đơn hàng gần đây</h2><a asp-controller="Orders" asp-action="Index">Tất cả đơn hàng →</a></div><partial name="_OrderTable" model="Model.Orders" />
@if(Model.Machines.Any(x=>x.Status==VmStatus.Creating)) { <div data-auto-refresh="5000" class="small muted refresh-note">Tự cập nhật khi máy đang khởi tạo.</div> }
