@model MachineDetailsVm
@{ var vm=Model.Machine; ViewData["Title"]=vm.VmName; }
<a class="back-link" asp-action="Index">← Máy ảo của tôi</a><div class="section-heading"><div><span class="eyebrow">WORKSPACE / #@vm.Id</span><h1>@vm.VmName</h1><p class="muted">@vm.Order.PlanName</p></div><span class="badge-state @vm.Status.ToString().ToLowerInvariant()">@Display.Status(vm.Status)</span></div>
<div class="stats-grid three"><div class="stat"><span>CPU</span><strong>@vm.Order.CPU vCPU</strong></div><div class="stat"><span>Bộ nhớ RAM</span><strong>@vm.Order.RAM GB</strong></div><div class="stat"><span>SSD</span><strong>@vm.Order.Storage GB</strong></div></div>
<div class="split-layout"><section class="panel"><h2>Điều khiển máy ảo</h2><p class="muted">Thao tác thay đổi trạng thái trong cơ sở dữ liệu, không điều khiển hạ tầng thật.</p><partial name="_VmActions" model="vm" /><hr /><dl class="key-values"><dt>Khởi tạo lúc</dt><dd>@Display.Date(vm.CreatedAt)</dd><dt>Cập nhật gần nhất</dt><dd>@Display.Date(vm.UpdatedAt)</dd><dt>Hết hạn thuê</dt><dd>@Display.Date(vm.ExpiresAt)</dd><dt>Đơn hàng</dt><dd>#@vm.OrderId.ToString("D5")</dd></dl>@if(vm.Status==VmStatus.Creating) { <p data-auto-refresh="5000" class="notice">Đang khởi tạo hoặc khởi động lại. Trang tự cập nhật sau mỗi 5 giây.</p> }</section>
<aside class="panel"><h3>Thông tin kết nối mẫu</h3><div class="notice">Địa chỉ IP dành cho tài liệu. Không thể dùng tài khoản này để SSH hoặc Remote Desktop.</div><label>Địa chỉ IP</label><input value="@vm.IpAddress" readonly aria-label="IP mô phỏng" /><label>Tên đăng nhập</label><input value="@vm.Username" readonly aria-label="Tên đăng nhập máy ảo" /><label for="vm-password">Mật khẩu mô phỏng</label><div class="password-row"><input id="vm-password" type="password" value="@Model.Password" readonly autocomplete="off" /><button type="button" class="btn btn-outline" data-toggle-password="vm-password" aria-pressed="false">Hiện</button></div><small class="muted">Chỉ chủ sở hữu máy mới xem được thông tin kết nối.</small></aside></div>
