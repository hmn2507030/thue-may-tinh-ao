@model LoginVm
@{ ViewData["Title"]="Đăng nhập"; }
<div class="auth-layout"><div class="auth-copy"><span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span><h1>Mọi máy ảo.<br />Một bảng điều khiển.</h1><p>Theo dõi tài nguyên, quản lý đơn thuê và tiếp tục công việc của bạn.</p></div><section class="panel auth-panel"><h2>Đăng nhập</h2><p class="muted">Sử dụng tài khoản đã đăng ký.</p><form asp-action="Login" method="post"><div asp-validation-summary="All" class="validation"></div><input asp-for="ReturnUrl" type="hidden" />
<label asp-for="Email">Email</label><input asp-for="Email" autocomplete="username" required />
<label asp-for="Password">Mật khẩu</label><input asp-for="Password" autocomplete="current-password" required />
<label class="check-label"><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label><button class="btn btn-primary full form-submit">Đăng nhập</button></form><p class="auth-bottom">Chưa có tài khoản? <a asp-action="Register">Tạo tài khoản</a></p></section></div>
