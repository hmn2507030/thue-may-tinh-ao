@model CatalogVm
@{ ViewData["Title"]="Gói dịch vụ"; }
<div class="page-heading"><span class="eyebrow">CẤU HÌNH CHO MỌI NHU CẦU</span><h1>Chọn workspace của bạn</h1><p>Giá niêm yết theo tháng. Tất cả dịch vụ trong phiên bản này đều là mô phỏng.</p></div>
<form asp-action="Index" method="get" class="filter-bar panel"><div><label asp-for="Q">Tên gói</label><input asp-for="Q" placeholder="Tìm cấu hình..." /></div><div><label asp-for="Type">Loại dịch vụ</label><select asp-for="Type" asp-items="Html.GetEnumSelectList<PlanType>()"><option value="">Tất cả loại</option></select></div><div><label asp-for="MaxPrice">Giá tối đa / tháng</label><input asp-for="MaxPrice" type="number" min="0" step="1000" placeholder="VNĐ" /></div><div><label asp-for="MinCpu">CPU tối thiểu</label><input asp-for="MinCpu" type="number" min="1" placeholder="vCPU" /></div><div><label asp-for="MinRam">RAM tối thiểu</label><input asp-for="MinRam" type="number" min="1" placeholder="GB" /></div><div><label asp-for="MinStorage">SSD tối thiểu</label><input asp-for="MinStorage" type="number" min="1" placeholder="GB" /></div><button class="btn btn-primary">Lọc gói</button><a class="reset-link" asp-action="Index">Xóa lọc</a><div asp-validation-summary="All" class="validation"></div></form>
<p class="muted">Tìm thấy @Model.Plans.Count gói dịch vụ</p>
@if(Model.Plans.Count==0) { <div class="empty-state"><h3>Chưa có gói phù hợp</h3><p>Hãy giảm yêu cầu cấu hình hoặc tăng mức giá tối đa.</p></div> }
<div class="plan-grid">@foreach(var plan in Model.Plans) { <partial name="_PlanCard" model="plan" /> }</div>
