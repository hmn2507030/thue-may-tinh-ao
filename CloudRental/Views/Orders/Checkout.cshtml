@model CheckoutVm
@{ ViewData["Title"]="Đặt thuê máy ảo"; var plan=Model.Plan!; }
<a class="back-link" asp-controller="Plans" asp-action="Details" asp-route-id="@plan.Id">← Chi tiết gói</a><div class="page-heading"><span class="eyebrow">HOÀN TẤT LỰA CHỌN</span><h1>Đặt thuê máy tính ảo</h1><p>Kiểm tra cấu hình và thời hạn trước khi gửi yêu cầu.</p></div>
<div class="split-layout"><section class="panel"><h2>@plan.Name</h2><div class="config-row"><span>@plan.CPU vCPU</span><span>@plan.RAM GB RAM</span><span>@plan.Storage GB SSD</span></div><p>@plan.Description</p><form asp-action="Checkout" method="post" id="checkout-form" data-monthly="@plan.PricePerMonth.ToString(System.Globalization.CultureInfo.InvariantCulture)"><div asp-validation-summary="All" class="validation"></div><input asp-for="PlanId" type="hidden" /><label asp-for="Months">Thời hạn thuê</label><select asp-for="Months" id="rental-months"><option value="1">1 tháng</option><option value="3">3 tháng</option><option value="6">6 tháng</option><option value="12">12 tháng</option></select><div class="notice">Đây là đặt hàng mô phỏng. Sau khi gửi, quản trị viên sẽ duyệt đơn và hệ thống cấp máy ảo mẫu.</div><button class="btn btn-primary full">Xác nhận đặt thuê</button></form></section><aside class="panel checkout-summary"><h3>Tóm tắt đơn hàng</h3><dl class="key-values"><dt>Gói dịch vụ</dt><dd>@plan.Name</dd><dt>Đơn giá / tháng</dt><dd>@Display.Money(plan.PricePerMonth)</dd><dt>Thời hạn</dt><dd><span id="month-label">@Model.Months</span> tháng</dd></dl><hr /><p class="muted">Tổng giá trị mô phỏng</p><div class="price" id="rental-total">@Display.Money(plan.PricePerMonth * Model.Months)</div><p class="small muted">Tổng tiền được tính lại trên máy chủ. Không thu thêm phí và không áp dụng giảm giá.</p></aside></div>
