@model List<Plan>
@{ ViewData["Title"]="Hạ tầng ảo, trải nghiệm thật"; }
<section class="hero"><div class="hero-copy"><span class="eyebrow">CLOUD WORKSPACE / STUDENT PROJECT</span><h1>Không gian làm việc.<br /><span>Không giới hạn.</span></h1><p>Khám phá VPS và Virtual Desktop. Chọn cấu hình, tạo đơn thuê và quản lý máy tính ảo ngay trên một bảng điều khiển.</p><div class="actions"><a class="btn btn-primary" asp-controller="Plans" asp-action="Index">Khám phá gói dịch vụ ↗</a><a class="btn btn-outline" asp-controller="Dashboard" asp-action="Index">Vào bảng điều khiển</a></div><div class="hero-notes"><span>01. Chọn cấu hình</span><span>02. Chờ duyệt đơn</span><span>03. Quản lý máy ảo</span></div></div>
<div class="hero-console" aria-label="Minh họa dashboard"><div class="console-head"><span><i></i><i></i><i></i></span><small>cloudrental / demo</small></div><div class="console-body"><span class="eyebrow">YOUR VIRTUAL WORKSPACE</span><div class="server-symbol"><span></span><span></span><span></span></div><div class="console-line"><strong>cloud-demo</strong><span class="badge-state running">Running</span></div><div class="console-specs"><div><strong>4</strong><small>vCPU</small></div><div><strong>8 GB</strong><small>RAM</small></div><div><strong>120 GB</strong><small>SSD</small></div></div><div class="console-note">Giao diện minh họa - không phải máy ảo thật</div></div></div></section>
<section class="feature-strip"><div><strong>VPS & Desktop</strong><span>Hai loại dịch vụ trong một hệ thống</span></div><div><strong>Quản lý tập trung</strong><span>Đơn hàng, cấu hình và trạng thái</span></div><div><strong>Điều khiển đơn giản</strong><span>Start / Stop / Restart mô phỏng</span></div></section>
<section><div class="section-heading"><div><span class="eyebrow">CHỌN KHỞI ĐẦU CỦA BẠN</span><h2>Cấu hình phù hợp. Chi phí rõ ràng.</h2></div><a asp-controller="Plans" asp-action="Index">Xem tất cả gói →</a></div><div class="plan-grid">@foreach(var p in Model) { <partial name="_PlanCard" model="p" /> }</div></section>
<section class="note-banner"><h3>Từ yêu cầu đến máy ảo, chỉ vài bước.</h3><p>Tài khoản khách hàng tạo đơn. Quản trị viên xét duyệt. Hệ thống tự tạo máy mô phỏng và mở bảng điều khiển cho bạn.</p><a class="btn btn-outline" asp-controller="Account" asp-action="Register">Tạo tài khoản miễn phí</a></section>
