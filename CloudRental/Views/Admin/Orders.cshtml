@model List<Order>
@{ ViewData["Title"]="Quản lý đơn hàng"; var current=ViewBag.Status as OrderStatus?; }
<div class="page-heading"><span class="eyebrow">ORDER DESK</span><h1>Quản lý đơn hàng</h1><p class="lead">Duyệt hoặc từ chối đơn thuê. Đơn được duyệt sẽ tạo máy ảo mô phỏng cho khách hàng.</p></div>
<partial name="_AdminNav" />
<div class="tabs">@foreach(var item in new (string Label, OrderStatus? Status)[] { ("Tất cả",null),("Chờ duyệt",OrderStatus.Pending),("Đã duyệt",OrderStatus.Approved),("Từ chối",OrderStatus.Rejected),("Đã hủy",OrderStatus.Cancelled) }) { <a class="@(current==item.Status ? "active" : "")" asp-action="Orders" asp-route-status="@item.Status">@item.Label</a> }</div>
<div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Gói / cấu hình</th><th>Thời hạn</th><th>Tổng tiền</th><th>Trạng thái</th><th>Hành động</th></tr></thead><tbody>
@foreach(var o in Model) { <tr><td>#@o.Id.ToString("D5")<small class="block muted">@Display.Date(o.CreatedAt)</small></td><td><strong>@o.User.FullName</strong><small class="block muted">@o.User.Email</small></td><td><strong>@o.PlanName</strong><small class="block muted">@o.CPU vCPU / @o.RAM GB / @o.Storage GB</small></td><td>@o.Months tháng</td><td>@Display.Money(o.Total)</td><td><span class="badge-state @o.Status.ToString().ToLowerInvariant()">@Display.Status(o.Status)</span></td><td class="table-actions">@if(o.Status==OrderStatus.Pending) { <form asp-action="Review" asp-route-id="@o.Id" asp-route-decision="approve" method="post" data-confirm="Duyệt đơn và cấp máy ảo mô phỏng?"><button class="btn btn-small btn-primary">Duyệt</button></form><form asp-action="Review" asp-route-id="@o.Id" asp-route-decision="reject" method="post" data-confirm="Từ chối đơn hàng này?"><button class="btn btn-small btn-outline">Từ chối</button></form> } else { <span class="muted">—</span> }</td></tr> }
</tbody></table></div>
