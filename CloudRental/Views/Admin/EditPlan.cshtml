@model Plan
@{ ViewData["Title"]=Model.Id==0 ? "Thêm gói dịch vụ" : "Sửa gói dịch vụ"; }
<a class="back-link" asp-action="Plans">← Quản lý gói dịch vụ</a><div class="page-heading"><span class="eyebrow">CATALOG / @(Model.Id==0 ? "NEW" : "EDIT")</span><h1>@ViewData["Title"]</h1><p class="lead">Thay đổi chỉ ảnh hưởng tới đơn hàng tạo mới. Đơn cũ giữ nguyên cấu hình và giá tại thời điểm đặt.</p></div>
<section class="panel form-panel"><form asp-action="EditPlan" method="post"><div asp-validation-summary="All" class="validation"></div><input asp-for="Id" type="hidden" />
<label asp-for="Name">Tên gói</label><input asp-for="Name" required maxlength="80" /><label asp-for="Type">Loại dịch vụ</label><select asp-for="Type" asp-items="Html.GetEnumSelectList<PlanType>()"></select>
<div class="form-grid three"><div><label asp-for="CPU">CPU (vCPU)</label><input asp-for="CPU" type="number" min="1" max="128" required /></div><div><label asp-for="RAM">RAM (GB)</label><input asp-for="RAM" type="number" min="1" max="1024" required /></div><div><label asp-for="Storage">Lưu trữ (GB SSD)</label><input asp-for="Storage" type="number" min="10" max="100000" required /></div></div>
<label asp-for="PricePerMonth">Giá thuê mỗi tháng (VNĐ)</label><input asp-for="PricePerMonth" type="number" step="1000" min="1000" required /><label asp-for="Description">Mô tả</label><textarea asp-for="Description" rows="4" maxlength="2000" required></textarea><label class="check-label"><input asp-for="IsActive" /> Hiển thị gói cho khách hàng</label><button class="btn btn-primary full form-submit">Lưu gói dịch vụ</button></form></section>
